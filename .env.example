# Secrets and infrastructure only. Everything about agent behaviour lives in config/*.yaml
# (architecture v0.6 §3). Copy to .env and fill in - .env is gitignored.

# --- database ---------------------------------------------------------------
POSTGRES_USER=research
POSTGRES_PASSWORD=change-me
POSTGRES_DB=research
DATABASE_URL=postgresql+psycopg://research:change-me@postgres:5432/research

# --- application ------------------------------------------------------------
# Fernet key used to encrypt per-run provider keys in `run_secrets`.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json

# --- compose profiles -------------------------------------------------------
# `observability` brings up Langfuse (+ ClickHouse, Redis, MinIO). Leave empty for lightweight
# mode: the system stays fully functional on Postgres traces and the YAML prompt seeds.
COMPOSE_PROFILES=observability

# --- provider keys (optional defaults) --------------------------------------
# Keys entered in the UI take precedence and are stored encrypted for the duration of a run only.
GEMINI_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# --- PII --------------------------------------------------------------------
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000

# --- Langfuse (headless init creates the org, project, user and keys) -------
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_INIT_ORG_ID=apilex
LANGFUSE_INIT_PROJECT_ID=research-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
